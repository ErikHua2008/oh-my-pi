{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "windows-msvc",
			"displayName": "Windows x64 (Visual Studio 2022)",
			"generator": "Visual Studio 17 2022",
			"architecture": "x64",
			"binaryDir": "${sourceDir}/out/build/windows-msvc",
			"cacheVariables": {
				"OMP_CPP_SHELL_BUILD_TESTS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows-msvc-debug",
			"configurePreset": "windows-msvc",
			"configuration": "Debug"
		},
		{
			"name": "windows-msvc-release",
			"configurePreset": "windows-msvc",
			"configuration": "Release"
		}
	],
	"testPresets": [
		{
			"name": "windows-msvc-debug",
			"configurePreset": "windows-msvc",
			"configuration": "Debug",
			"output": {
				"outputOnFailure": true
			}
		}
	]
}
